# Postgres. Provision one (Vercel Postgres, Neon, Supabase, ...) and paste its connection string.
DATABASE_URL=postgres://user:password@host:5432/instar

# Stripe (test mode keys until Sprint 6 — see CLAUDE.md "Working conventions").
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --print-secret` locally, or the endpoint's signing secret in the Stripe
# dashboard once a live webhook endpoint exists.
STRIPE_WEBHOOK_SECRET=whsec_...

# Basis points, not percentages: 200 = 2.00%. Decided 2026-09-26 — see lib/commerce/money.ts.
PLATFORM_TAKE_RATE_BPS=200
SERVICE_FEE_RATE_BPS=300
